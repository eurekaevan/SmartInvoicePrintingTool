<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartInvoicePrintingTool.App"
             xmlns:local="using:SmartInvoicePrintingTool"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        
        <!-- 全局前卫无衬线科技字体体系 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei, sans-serif" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- 大胆赛博霓虹卡片边框 -->
        <Style Selector="Border.cyber-card">
            <Setter Property="Background" Value="#0D0E19" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#2A2B45" />
                        <GradientStop Offset="0.5" Color="#8B5CF6" />
                        <GradientStop Offset="1.0" Color="#1D1E30" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BoxShadow" Value="0 10 30 0 #40000000, 0 0 15 0 #208B5CF6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.cyber-card:pointerover">
            <Setter Property="BoxShadow" Value="0 12 35 0 #60000000, 0 0 25 0 #408B5CF6" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#EC4899" />
                        <GradientStop Offset="0.5" Color="#8B5CF6" />
                        <GradientStop Offset="1.0" Color="#06B6D4" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 超炫主操作按钮 (大红紫青炫彩渐变) -->
        <Style Selector="Button.btn-cyber-primary">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#EC4899" />
                        <GradientStop Offset="0.5" Color="#8B5CF6" />
                        <GradientStop Offset="1.0" Color="#3B82F6" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="26,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.btn-cyber-primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#F472B6" />
                        <GradientStop Offset="0.5" Color="#A78BFA" />
                        <GradientStop Offset="1.0" Color="#60A5FA" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险强终止按钮 -->
        <Style Selector="Button.btn-cyber-danger">
            <Setter Property="Background" Value="#1F0F1A" />
            <Setter Property="Foreground" Value="#FF4D4D" />
            <Setter Property="BorderBrush" Value="#FF2A55" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.btn-cyber-danger:pointerover">
            <Setter Property="Background" Value="#FF2A55" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>

        <!-- 霓虹科技线框浏览按钮 -->
        <Style Selector="Button.btn-cyber-outline">
            <Setter Property="Background" Value="#141526" />
            <Setter Property="Foreground" Value="#06B6D4" />
            <Setter Property="BorderBrush" Value="#06B6D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.btn-cyber-outline:pointerover">
            <Setter Property="Background" Value="#06B6D4" />
            <Setter Property="Foreground" Value="#090A10" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- 图标按钮 -->
        <Style Selector="Button.btn-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.btn-icon:pointerover">
            <Setter Property="Background" Value="#25273C" />
        </Style>

        <!-- TextBox 赛博极客设计 -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#080911" />
            <Setter Property="BorderBrush" Value="#232438" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- ComboBox 赛博极客设计 -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#080911" />
            <Setter Property="BorderBrush" Value="#232438" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Styles>
</Application>