<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             x:Class="SmartInvoicePrintingTool.Views.Components.ProcessingStatusView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="material-card" Padding="24,21">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="处理进度"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontWeight="Medium" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="14"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               MaxLines="2" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource BrushPrimaryContainer}"
                        CornerRadius="16"
                        Padding="13,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushOnPrimaryContainer}" />
                </Border>
            </Grid>

            <ProgressBar Value="{Binding ProgressValue}"
                         Minimum="0"
                         Maximum="100"
                         Height="8"
                         CornerRadius="4"
                         Background="{StaticResource BrushSurfaceRaised}"
                         Foreground="{StaticResource BrushPrimary}" />
        </StackPanel>
    </Border>
</UserControl>
