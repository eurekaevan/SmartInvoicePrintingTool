<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePress.ViewModels"
             x:Class="InvoicePress.Views.Components.ProcessingStatusView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="workspace-card" Padding="15,12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Grid.Column="0"
                    Width="34"
                    Height="34"
                    CornerRadius="7"
                    Background="{StaticResource BrushBrandSoft}"
                    VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconActivity}"
                          Foreground="{StaticResource BrushBrand}"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{StaticResource BrushInk}"
                               TextWrapping="Wrap"
                               MaxLines="2" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}"
                               Margin="12,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushBrand}" />
                </Grid>

                <ProgressBar Value="{Binding ProgressValue}"
                             Minimum="0"
                             Maximum="100"
                             Height="5"
                             CornerRadius="2.5"
                             Background="{StaticResource BrushLine}"
                             Foreground="{StaticResource BrushBrand}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Command="{Binding StopProcessingCommand}"
                    IsEnabled="{Binding IsCancellable}"
                    Classes="command-danger"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource IconStop}"
                              Foreground="{StaticResource BrushDanger}"
                              Width="13"
                              Height="13" />
                    <TextBlock Text="停止任务" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
