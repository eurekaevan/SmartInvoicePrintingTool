<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             x:Class="SmartInvoicePrintingTool.Views.Components.AppHeaderView"
             x:DataType="vm:MainWindowViewModel">
    <Border Padding="30,18"
            Background="{StaticResource BrushSurface}"
            BorderBrush="#1F79747E"
            BorderThickness="0,0,0,1"
            BoxShadow="0 2 5 0 #18000000">
        <Grid ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0" ColumnDefinitions="48,*" ColumnSpacing="16" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="14"
                        Background="{StaticResource BrushPrimary}">
                    <PathIcon Data="{StaticResource IconReceipt}"
                              Foreground="White"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="智能发票合并打印工具"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="批量识别、智能合并与打印，一站式完成发票处理"
                               MaxWidth="580"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12.5"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1"
                    Background="{StaticResource BrushSuccessContainer}"
                    CornerRadius="18"
                    Padding="13,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SystemStatusText}"
                               FontSize="12"
                               Foreground="{StaticResource BrushSuccess}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
