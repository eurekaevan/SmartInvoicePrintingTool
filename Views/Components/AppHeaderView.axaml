<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePress.ViewModels"
             x:Class="InvoicePress.Views.Components.AppHeaderView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{StaticResource BrushHeader}"
            BorderBrush="#334158"
            BorderThickness="0,0,0,1">
        <Grid MaxWidth="1380"
              Margin="24,0"
              Height="64"
              HorizontalAlignment="Stretch"
              ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0" ColumnDefinitions="36,*" ColumnSpacing="11" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="7"
                        Background="{StaticResource BrushBrand}">
                    <PathIcon Data="{StaticResource IconReceipt}"
                              Foreground="White"
                              Width="19"
                              Height="19"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="发票印擎"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="InvoicePress · 配对、合并与打印"
                               FontSize="11.5"
                               Foreground="#CBD4E0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <TextBlock Text="当前状态"
                           FontSize="11.5"
                           Foreground="#B8C3D1"
                           VerticalAlignment="Center" />
                <Border Background="{StaticResource BrushHeaderRaised}"
                        BorderBrush="#425069"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#55D69E"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SystemStatusText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E8EEF7" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
