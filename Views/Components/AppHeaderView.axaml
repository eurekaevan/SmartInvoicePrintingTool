<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePress.ViewModels"
             x:Class="InvoicePress.Views.Components.AppHeaderView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{StaticResource BrushHeader}"
            BorderBrush="#334158"
            BorderThickness="0,0,0,1">
        <Grid MaxWidth="1380"
              Margin="32,0"
              Height="76"
              HorizontalAlignment="Stretch"
              ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0" ColumnDefinitions="42,*" ColumnSpacing="14" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Width="42"
                        Height="42"
                        CornerRadius="8"
                        Background="{StaticResource BrushBrand}">
                    <PathIcon Data="{StaticResource IconReceipt}"
                              Foreground="White"
                              Width="21"
                              Height="21"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="发票印擎"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="InvoicePress · 配对、合并与打印"
                               FontSize="11.5"
                               Foreground="#AEB9C8" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="当前状态"
                           FontSize="11.5"
                           Foreground="#8F9CAF"
                           VerticalAlignment="Center" />
                <Border Background="{StaticResource BrushHeaderRaised}"
                        BorderBrush="#425069"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="11,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#55D69E"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SystemStatusText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E8EEF7" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
