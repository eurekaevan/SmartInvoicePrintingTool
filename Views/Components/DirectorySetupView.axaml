<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             x:Class="SmartInvoicePrintingTool.Views.Components.DirectorySetupView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="material-card">
        <StackPanel Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                    <Border Classes="icon-container">
                        <PathIcon Data="{StaticResource IconFolder}"
                                  Foreground="{StaticResource BrushPrimary}"
                                  Width="19"
                                  Height="19"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="选择文件目录" Classes="section-title" />
                        <TextBlock Text="指定待处理发票和合并文件的保存位置" Classes="supporting-text" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource BrushPrimaryContainer}"
                        CornerRadius="14"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="第 1 步"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushOnPrimaryContainer}" />
                </Border>
            </Grid>

            <StackPanel Spacing="9">
                <TextBlock Text="源发票目录" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             Text="{Binding SourcePath}"
                             PlaceholderText="请选择包含待处理 PDF 发票的文件夹"
                             IsReadOnly="True"
                             Height="48"
                             Padding="14,0"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="选择目录"
                            Command="{Binding BrowseSourceCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            Classes="material-tonal"
                            Height="44"
                            MinWidth="104" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="9">
                <TextBlock Text="输出目录" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputPath}"
                             PlaceholderText="请选择合并后 PDF 文件的保存位置"
                             IsReadOnly="True"
                             Height="48"
                             Padding="14,0"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="选择目录"
                            Command="{Binding BrowseOutputCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            Classes="material-tonal"
                            Height="44"
                            MinWidth="104" />
                </Grid>
            </StackPanel>

            <Border Background="{StaticResource BrushSurfaceRaised}"
                    CornerRadius="10"
                    Padding="14,11">
                <TextBlock Text="提示：源目录与输出目录不能相同；输出目录中的同名合并文件将被替换。"
                           FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
