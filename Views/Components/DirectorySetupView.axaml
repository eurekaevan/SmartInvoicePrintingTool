<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             x:Class="SmartInvoicePrintingTool.Views.Components.DirectorySetupView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="workspace-card" Padding="24,22">
        <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="01  文件准备" Classes="section-kicker" />
                    <TextBlock Text="指定输入与产出位置" Classes="section-title" />
                    <TextBlock Text="系统将扫描源目录中的 PDF，配对后生成到输出目录。"
                               Classes="body-muted"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource BrushWarningSoft}"
                        CornerRadius="6"
                        Padding="11,7"
                        VerticalAlignment="Top">
                    <TextBlock Text="同名输出自动替换"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushWarning}" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0"
                        Background="{StaticResource BrushSurfaceSubtle}"
                        BorderBrush="{StaticResource BrushLine}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <PathIcon Grid.Column="0"
                                      Data="{StaticResource IconFolder}"
                                      Foreground="{StaticResource BrushBrand}"
                                      Width="16"
                                      Height="16" />
                            <TextBlock Grid.Column="1" Text="源 PDF 目录" Classes="field-label" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SourcePath}"
                                     PlaceholderText="选择包含待处理 PDF 的文件夹"
                                     IsReadOnly="True"
                                     Height="44"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip.Tip="{Binding SourcePath}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowseSourceCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    Classes="browse-button"
                                    MinWidth="76"
                                    Height="42" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource BrushSurfaceSubtle}"
                        BorderBrush="{StaticResource BrushLine}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <PathIcon Grid.Column="0"
                                      Data="{StaticResource IconFile}"
                                      Foreground="{StaticResource BrushSuccess}"
                                      Width="16"
                                      Height="16" />
                            <TextBlock Grid.Column="1" Text="合并输出目录" Classes="field-label" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputPath}"
                                     PlaceholderText="选择合并 PDF 的保存文件夹"
                                     IsReadOnly="True"
                                     Height="44"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip.Tip="{Binding OutputPath}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowseOutputCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    Classes="browse-button"
                                    MinWidth="76"
                                    Height="42" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="为避免源文件被当作输出处理，两个目录不能相同。"
                       Classes="body-muted" />
        </StackPanel>
    </Border>
</UserControl>
