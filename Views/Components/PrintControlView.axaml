<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             x:Class="SmartInvoicePrintingTool.Views.Components.PrintControlView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="cyber-card">
        <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Border Classes="icon-tile">
                        <PathIcon Data="{StaticResource IconPrinter}"
                                  Foreground="{StaticResource BrushAccent}"
                                  Width="17"
                                  Height="17"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LPrinterSelect}" Classes="section-title" />
                        <TextBlock Text="DEVICE &amp; ACTION" FontSize="10" Foreground="{StaticResource BrushTextMuted}" LetterSpacing="1" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#174CC9F0"
                        CornerRadius="12"
                        Padding="9,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="STEP 02" FontSize="10" FontWeight="SemiBold" Foreground="#A5E9FA" LetterSpacing="0.7" />
                </Border>
            </Grid>

            <ComboBox ItemsSource="{Binding Printers}"
                      SelectedItem="{Binding SelectedPrinter}"
                      PlaceholderText="{Binding LPrinterPlaceholder}"
                      IsEnabled="{Binding !IsBusy}"
                      HorizontalAlignment="Stretch"
                      MinHeight="44" />

            <Button Command="{Binding StartProcessingCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="btn-cyber-primary"
                    Height="48"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <PathIcon Data="{StaticResource IconPlay}" Foreground="White" Width="17" Height="17" />
                    <TextBlock Text="{Binding LStartPrint}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button Command="{Binding StopProcessingCommand}"
                    IsEnabled="{Binding IsCancellable}"
                    Classes="btn-cyber-danger"
                    Height="42"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconStop}" Foreground="{StaticResource BrushDanger}" Width="15" Height="15" />
                    <TextBlock Text="{Binding LForceStop}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
