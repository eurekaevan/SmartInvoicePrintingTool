<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePress.ViewModels"
             x:Class="InvoicePress.Views.Components.PrintControlView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="workspace-card" Padding="24,22">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="02  执行任务" Classes="section-kicker" />
                <TextBlock Text="先生成，后打印" Classes="section-title" />
                <TextBlock Text="合并与打印完全分开，可先核对文件配对再提交打印。"
                           Classes="body-muted"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,40,*">
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBrandSoft}"
                        BorderBrush="#C9D5FA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="15">
                        <Grid Grid.Row="0" ColumnDefinitions="36,*" ColumnSpacing="11">
                            <Border Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource BrushBrand}">
                                <TextBlock Text="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="生成合并 PDF"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushInk}" />
                                <TextBlock Text="扫描、配对、缩放并写入输出目录"
                                           Classes="body-muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="此操作不会自动打印。生成后请在下方确认每组合并关系。"
                                   FontSize="11.5"
                                   Foreground="{StaticResource BrushOnBrandSoft}"
                                   TextWrapping="Wrap" />

                        <Button Grid.Row="2"
                                Command="{Binding StartMergingCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Classes="command-primary"
                                Height="46"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconMerge}"
                                          Foreground="White"
                                          Width="16"
                                          Height="16" />
                                <TextBlock Text="开始合并" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="*,Auto,*">
                    <Border Grid.Row="0"
                            Width="1"
                            Background="{StaticResource BrushLine}"
                            HorizontalAlignment="Center" />
                    <Border Grid.Row="1"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushLine}"
                            BorderThickness="1">
                        <TextBlock Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushInkMuted}" />
                    </Border>
                    <Border Grid.Row="2"
                            Width="1"
                            Background="{StaticResource BrushLine}"
                            HorizontalAlignment="Center" />
                </Grid>

                <Border Grid.Column="2"
                        Background="{StaticResource BrushSurfaceSubtle}"
                        BorderBrush="{StaticResource BrushLine}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="15">
                        <Grid Grid.Row="0" ColumnDefinitions="36,*" ColumnSpacing="11">
                            <Border Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource BrushHeader}">
                                <TextBlock Text="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="提交打印"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushInk}" />
                                <TextBlock Text="打印合并文件以及奇数时的单独文件"
                                           Classes="body-muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="7">
                            <TextBlock Text="目标打印机" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding Printers}"
                                      SelectedItem="{Binding SelectedPrinter}"
                                      PlaceholderText="选择可用打印设备"
                                      IsEnabled="{Binding !IsBusy}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Command="{Binding PrintResultsCommand}"
                                IsEnabled="{Binding CanPrintResults}"
                                Classes="command-secondary"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="打印本次成功合并的 PDF 和需单独打印的 PDF">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPrinter}"
                                          Foreground="White"
                                          Width="16"
                                          Height="16" />
                                <TextBlock Text="打印处理结果" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
