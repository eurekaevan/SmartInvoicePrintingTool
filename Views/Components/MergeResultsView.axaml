<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             xmlns:models="using:SmartInvoicePrintingTool.Models"
             x:Class="SmartInvoicePrintingTool.Views.Components.MergeResultsView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="workspace-card" Padding="0">
        <StackPanel>
            <Border Padding="24,20"
                    BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="03  核对结果" Classes="section-kicker" />
                        <TextBlock Text="合并文件清单" Classes="section-title" />
                        <TextBlock Text="{Binding MergeSummaryText}"
                                   Classes="body-muted" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            IsVisible="{Binding HasMergeResults}"
                            Background="{StaticResource BrushSuccessSoft}"
                            CornerRadius="6"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconCheck}"
                                      Foreground="{StaticResource BrushSuccess}"
                                      Width="14"
                                      Height="14" />
                            <TextBlock Text="{Binding SuccessfulMergeCount, StringFormat='{}{0} 份可打印'}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushSuccess}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasNoMergeResults}"
                    Background="{StaticResource BrushSurfaceSubtle}"
                    Padding="28,36"
                    CornerRadius="0,0,10,10">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="14" HorizontalAlignment="Center">
                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            CornerRadius="8"
                            Background="{StaticResource BrushBrandSoft}">
                        <PathIcon Data="{StaticResource IconMerge}"
                                  Foreground="{StaticResource BrushBrand}"
                                  Width="18"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="等待合并结果"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushInkSecondary}" />
                        <TextBlock Text="完成合并后，这里会逐组展示两个源文件与它们的输出文件。"
                                   Classes="body-muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl IsVisible="{Binding HasMergeResults}"
                          ItemsSource="{Binding MergeResults}"
                          Margin="18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MergeItemResult">
                        <Border Background="{StaticResource BrushSurfaceSubtle}"
                                BorderBrush="{StaticResource BrushLine}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid ColumnDefinitions="4,*">
                                <Border Grid.Column="0"
                                        IsVisible="{Binding IsSuccess}"
                                        Background="{StaticResource BrushSuccess}"
                                        CornerRadius="8,0,0,8" />
                                <Border Grid.Column="0"
                                        IsVisible="{Binding !IsSuccess}"
                                        Background="{StaticResource BrushDanger}"
                                        CornerRadius="8,0,0,8" />

                                <Grid Grid.Column="1"
                                      Margin="17,14"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="11">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="源文件配对"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushInkMuted}" />

                                        <Border Grid.Column="1"
                                                IsVisible="{Binding IsSuccess}"
                                                Background="{StaticResource BrushSuccessSoft}"
                                                CornerRadius="5"
                                                Padding="9,4">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushSuccess}" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding !IsSuccess}"
                                                Background="{StaticResource BrushDangerSoft}"
                                                CornerRadius="5"
                                                Padding="9,4">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushDanger}" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,34,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushLine}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,9">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                <PathIcon Grid.Column="0"
                                                          Data="{StaticResource IconFile}"
                                                          Foreground="{StaticResource BrushBrand}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="文件 A" Classes="field-label" FontSize="10.5" />
                                                    <TextBlock Text="{Binding FirstFileName}"
                                                               ToolTip.Tip="{Binding FirstFileName}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               FontSize="12.5"
                                                               LineHeight="18"
                                                               Foreground="{StaticResource BrushInk}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="+"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="17"
                                                   Foreground="{StaticResource BrushInkMuted}" />

                                        <Border Grid.Column="2"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushLine}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,9">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                <PathIcon Grid.Column="0"
                                                          Data="{StaticResource IconFile}"
                                                          Foreground="{StaticResource BrushBrand}"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="文件 B" Classes="field-label" FontSize="10.5" />
                                                    <TextBlock Text="{Binding SecondFileName}"
                                                               ToolTip.Tip="{Binding SecondFileName}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               FontSize="12.5"
                                                               LineHeight="18"
                                                               Foreground="{StaticResource BrushInk}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushLine}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0"
                                                       Text="→"
                                                       FontSize="16"
                                                       Foreground="{StaticResource BrushSuccess}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="输出文件" Classes="field-label" FontSize="10.5" />
                                                <TextBlock Text="{Binding OutputFileName}"
                                                           ToolTip.Tip="{Binding OutputPath}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushInk}" />
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           IsVisible="{Binding !IsSuccess}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource BrushDanger}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
