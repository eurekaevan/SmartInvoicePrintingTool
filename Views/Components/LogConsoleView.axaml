<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             x:Class="SmartInvoicePrintingTool.Views.Components.LogConsoleView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="material-card" Padding="0">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="{StaticResource BrushSurfaceRaised}"
                    Padding="18,13"
                    CornerRadius="16,16,0,0"
                    BorderBrush="#1F79747E"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource BrushPrimaryContainer}">
                            <PathIcon Data="{StaticResource IconTerminal}"
                                      Foreground="{StaticResource BrushPrimary}"
                                      Width="15"
                                      Height="15"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="运行日志"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="进度与异常记录，文件配对详见下方" Classes="supporting-text" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ClearLogCommand}"
                            Classes="material-text"
                            ToolTip.Tip="清空处理日志">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTrash}"
                                      Foreground="{StaticResource BrushPrimary}"
                                      Width="14"
                                      Height="14" />
                            <TextBlock Text="清空" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBox Grid.Row="1"
                     Text="{Binding LogContent, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="210"
                     BorderThickness="0"
                     CornerRadius="0,0,16,16"
                     Padding="18,15"
                     Background="{StaticResource BrushSurface}"
                     Foreground="{StaticResource BrushTextSecondary}"
                     FontFamily="Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, sans-serif"
                     FontSize="12"
                     LineHeight="19"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Border>
</UserControl>
