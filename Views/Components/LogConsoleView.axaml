<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
             xmlns:models="using:SmartInvoicePrintingTool.Models"
             x:Class="SmartInvoicePrintingTool.Views.Components.LogConsoleView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="workspace-card" Padding="0">
        <StackPanel>
            <Border Padding="24,18"
                    BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="04  运行记录" Classes="section-kicker" />
                        <TextBlock Text="处理日志" Classes="section-title" />
                        <TextBlock Text="{Binding LogEntryCount, StringFormat='{}{0} 条记录 · 最新记录在前'}"
                                   Classes="body-muted" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ClearLogCommand}"
                            IsEnabled="{Binding HasLogEntries}"
                            Classes="quiet-button"
                            VerticalAlignment="Center"
                            ToolTip.Tip="清空运行日志">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconTrash}"
                                      Foreground="{StaticResource BrushInkSecondary}"
                                      Width="14"
                                      Height="14" />
                            <TextBlock Text="清空日志" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasNoLogEntries}"
                    Background="{StaticResource BrushSurfaceSubtle}"
                    Padding="24,28"
                    CornerRadius="0,0,10,10">
                <TextBlock Text="暂无运行记录"
                           HorizontalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{StaticResource BrushInkMuted}" />
            </Border>

            <!-- 日志列表不使用内部 ScrollViewer，由主页面统一滚动浏览。 -->
            <ItemsControl IsVisible="{Binding HasLogEntries}"
                          ItemsSource="{Binding LogEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <Border BorderBrush="{StaticResource BrushLine}"
                                BorderThickness="0,0,0,1"
                                Padding="24,12">
                            <Grid ColumnDefinitions="72,1,*" ColumnSpacing="14">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="11.5"
                                           Foreground="{StaticResource BrushInkMuted}" />
                                <Border Grid.Column="1"
                                        Width="1"
                                        Background="{StaticResource BrushLine}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           FontSize="12.5"
                                           LineHeight="19"
                                           Foreground="{StaticResource BrushInkSecondary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
