<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePress.ViewModels"
             xmlns:models="using:InvoicePress.Models"
             x:Class="InvoicePress.Views.Components.LogConsoleView"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="workspace-card" Padding="0" Height="360">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="20,14"
                    BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="04  运行记录" Classes="section-kicker" />
                        <TextBlock Text="处理日志" Classes="section-title" />
                        <TextBlock Text="{Binding LogEntryCount, StringFormat='{}{0} 条记录 · 最新记录在前'}"
                                   Classes="body-muted" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ClearLogCommand}"
                            IsEnabled="{Binding HasLogEntries}"
                            Classes="quiet-button"
                            VerticalAlignment="Center"
                            ToolTip.Tip="清空运行日志">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconTrash}"
                                      Foreground="{StaticResource BrushInkSecondary}"
                                      Width="14"
                                      Height="14" />
                            <TextBlock Text="清空日志" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border IsVisible="{Binding HasNoLogEntries}"
                            Background="{StaticResource BrushSurfaceSubtle}"
                            Padding="20,22"
                            CornerRadius="0,0,10,10">
                        <TextBlock Text="暂无运行记录"
                                   HorizontalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{StaticResource BrushInkMuted}" />
                    </Border>

                    <ItemsControl IsVisible="{Binding HasLogEntries}"
                                  ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntry">
                                <Border BorderBrush="{StaticResource BrushLine}"
                                        BorderThickness="0,0,0,1"
                                        Padding="20,9">
                                    <Grid ColumnDefinitions="68,1,*" ColumnSpacing="11">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp}"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource BrushInkMuted}" />
                                        <Border Grid.Column="1"
                                                Width="1"
                                                Background="{StaticResource BrushLine}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12.5"
                                                   LineHeight="18"
                                                   Foreground="{StaticResource BrushInkSecondary}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
