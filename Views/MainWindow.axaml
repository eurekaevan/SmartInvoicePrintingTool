<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InvoicePress.ViewModels"
        xmlns:components="using:InvoicePress.Views.Components"
        x:Class="InvoicePress.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="发票印擎 · InvoicePress"
        Icon="/Assets/logo.ico"
        Width="1240"
        Height="860"
        MinWidth="960"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeaderView Grid.Row="0" />

        <!-- 页面保留主滚动区；处理清单与日志在固定高度内容区内独立滚动。 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1380"
                        Margin="32,28,32,40"
                        HorizontalAlignment="Stretch"
                        Spacing="16">
                <Border Background="{StaticResource BrushHeader}"
                        CornerRadius="10"
                        Padding="26,22">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="PDF 批量生产流程"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="按顺序完成目录配置、文件合并、结果核对与打印提交。"
                                       FontSize="12.5"
                                       Foreground="#B7C2D2"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#162457D6"
                                BorderBrush="#486FD9"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="13,9"
                                VerticalAlignment="Center">
                            <TextBlock Text="合并结果确认后才会提交打印"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="#DCE6FF" />
                        </Border>
                    </Grid>
                </Border>

                <components:DirectorySetupView />
                <components:PrintControlView />
                <components:ProcessingStatusView />
                <components:MergeResultsView />
                <components:LogConsoleView />

                <TextBlock Text="注意：“已提交打印”表示任务已交给 Windows 关联的 PDF 程序，不代表已确认物理出纸。"
                           Margin="4,2"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           Foreground="{StaticResource BrushInkMuted}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
