<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartInvoicePrintingTool.ViewModels"
        xmlns:components="using:SmartInvoicePrintingTool.Views.Components"
        x:Class="SmartInvoicePrintingTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="智能发票合并打印工具"
        Icon="/Assets/logo.ico"
        Width="1160"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushWindow}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <components:AppHeaderView Grid.Row="0" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1320"
                  Margin="28,24,28,32"
                  HorizontalAlignment="Stretch"
                  ColumnDefinitions="60*,24,40*">
                <StackPanel Grid.Column="0" Spacing="20">
                    <components:DirectorySetupView />
                    <components:ProcessingStatusView />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="20">
                    <components:PrintControlView />
                    <components:LogConsoleView />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
